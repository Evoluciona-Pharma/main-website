# Host nginx for https://www.evolucionapharma.com / evolucionapharma.com.
# Confirm the production hostname with DevOps before installing.
#
# sudo certbot --nginx -d evolucionapharma.com -d www.evolucionapharma.com

server {
    listen 80;
    listen [::]:80;
    server_name evolucionapharma.com www.evolucionapharma.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name evolucionapharma.com www.evolucionapharma.com;

    ssl_certificate     /etc/letsencrypt/live/evolucionapharma.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/evolucionapharma.com/privkey.pem;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
