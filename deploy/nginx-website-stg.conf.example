# Host nginx for https://staging.evolucionapharma.com on the staging VM.
# The Next.js container listens on 127.0.0.1:8080 (maps to 3001 inside).
# The browser calls the API at NEXT_PUBLIC_API_URL (api-stg), not through this
# vhost. Hub front already uses 8081; API uses 3000.
#
# sudo certbot --nginx -d staging.evolucionapharma.com

server {
    listen 80;
    listen [::]:80;
    server_name staging.evolucionapharma.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name staging.evolucionapharma.com;

    ssl_certificate     /etc/letsencrypt/live/staging.evolucionapharma.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.evolucionapharma.com/privkey.pem;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
